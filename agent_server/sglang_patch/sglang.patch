+    async def _continue_prompt(self, obj: GenerateReqInput) -> None:
+        """agent_server requests: extend the parent's tokens with the new messages (continuous token).
+
+        Groups with images are encoded by the HF processor, so the prompt comes out with every
+        image expanded, and the processor outputs of all its images go on as preprocessed image
+        data. The tokens before prefix_len are never decoded.
+        """
+        request, sent_ids = obj.continuation, list(obj.input_ids)
+        continuation = await asyncio.to_thread(
+            continue_prompt,
+            self.tokenizer,
+            self.processor if self.mm_processor is not None else None,
+            model_type=self.model_config.hf_config.model_type,
+            input_ids=sent_ids,
+            messages=request["messages"],
+            prefix_message_count=request["prefix_message_count"],
+            tools=request["tools"],
+            chat_template_kwargs=request["chat_template_kwargs"],
+        )
+        obj.input_ids = continuation.input_ids
+        if continuation.image_inputs is not None:
+            obj.image_data = [{"format": "processor_output", **continuation.image_inputs}]
+        if obj.return_routed_experts:
+            # Rows past the kept prefix depend on tokens continuous token replaced.
+            obj.routed_experts_start_len = min(obj.routed_experts_start_len, continuation.prefix_len)
+        obj.prompt_edit = {
+            "removed_prefix_token_count": len(sent_ids) - continuation.prefix_len,
+            "input_delta": continuation.input_ids[continuation.prefix_len :],
+            "routed_experts_start_len": obj.routed_experts_start_len,
+        }
+
     async def _tokenize_one_request(
         self,
         obj: Union[GenerateReqInput, EmbeddingReqInput],
     ):
         """Tokenize one request."""
+        if getattr(obj, "continuation", None) is not None:
+            await self._continue_prompt(obj)
         # Tokenize
         input_embeds = None
         input_text = obj.text
@@ -2576,6 +2610,8 @@ class TokenizerManager(TokenizerControlMixin, TokenizerManagerScoreMixin):
                         meta_info["indexer_topk_num_layers"] = n
             if getattr(recv_obj, "dp_ranks", None):
                 meta_info["dp_rank"] = recv_obj.dp_ranks[i]
