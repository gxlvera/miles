             return f"data: {chunk.model_dump_json()}\n\n"
 
         return None
+
+
+def _continuation(
+    request: ChatCompletionRequest, raw_request: Optional[Request]
+) -> Optional[Dict[str, Any]]:
+    """What continuous token needs to extend request.input_ids, for agent_server requests."""
+    if request.prefix_message_count is None:
+        return None
+    # The JSON exactly as the client sent it: templates render tools with tojson, and the request
+    # models would reorder their keys (Function puts description before name). FastAPI has already
+    # read the body, which Starlette keeps on the request.
+    if raw_request is not None:
+        body = json.loads(raw_request._body)
+    else:
+        body = request.model_dump(mode="json", exclude_unset=True)
+    return {
+        "messages": body["messages"],
+        "prefix_message_count": request.prefix_message_count,
+        "tools": body.get("tools"),
+        "chat_template_kwargs": body.get("chat_template_kwargs") or {},
+    }
